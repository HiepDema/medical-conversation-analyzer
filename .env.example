# LLM (OpenAI-compatible endpoint — local llama-server or cloud)
LLM_BASE_URL=http://127.0.0.1:8899/v1
LLM_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ASR — Zipformer ONNX files (run scripts/download_models.sh)
ASR_ENCODER=./models/zipformer-offline/encoder-epoch-20-avg-10.int8.onnx
ASR_DECODER=./models/zipformer-offline/decoder-epoch-20-avg-10.int8.onnx
ASR_JOINER=./models/zipformer-offline/joiner-epoch-20-avg-10.int8.onnx
ASR_TOKENS=./models/zipformer-offline/config.json
ASR_SAMPLE_RATE=16000

# ICA diarization
ICA_N_COMPONENTS=2
ICA_FALLBACK_TO_ENERGY=1
